[Unit]
Description=Home flight tracker (e-ink)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/flight-tracker
ExecStart=/usr/bin/python3 /home/pi/flight-tracker/run.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
